def decode(data: Bytes, offset: Int, length: Int, budget: Int) -> Result[Bytes]
  output: List[Int] = []
  node = 0
  tail_bits = 0
  tail = 0
  for cursor in offset...(offset + length)
    byte = data[cursor]
    for shift in 0..7
      bit = byte.shift_right(7 - shift).bit_and(1)
      edge = TRIE[node + bit]
      if edge < 0
        symbol = -edge - 1
        return invalid(offset) if symbol == 256
        if output.size == budget
          return error("header list exceeds its limit at byte #{offset}", kind: "hpack.header_list_size")
        end

        output = output.push(symbol)
        node = 0
        tail_bits = 0
        tail = 0
      else
        node = edge
        tail_bits = tail_bits + 1
        tail = tail.shift_left(1).bit_or(bit)
      end
    end
  end

  return invalid(offset) if tail_bits > 7 or tail != 1.shift_left(tail_bits) - 1
  Bytes.from_list(output)
end

